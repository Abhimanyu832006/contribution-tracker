# ============================================================
# Contribution Tracker — Environment Variables Example
# Copy this file to .env.local and fill in your real credentials
# ============================================================

# Database Connection (Postgres / Supabase / Neon / Localhost)
# On Supabase specifically: use the "Transaction" pooler connection string
# (port 6543, with ?pgbouncer=true), NOT the "Session" pooler (port 5432).
# Session mode caps out at a small number of concurrent clients and gets
# exhausted almost immediately by Vercel's serverless functions, each
# spinning up its own connection pool — surfacing as
# "(EMAXCONNSESSION) max clients reached in session mode".
DATABASE_URL=postgresql://postgres:password@localhost:5432/contribution_tracker

# NextAuth Secret (Generate via `npx auth secret` or random 32+ char string)
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App Credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth Client Credentials (from https://console.cloud.google.com/apis/credentials)
# Used only for Faculty sign-in (login-only: openid email profile — no
# Drive/Docs access, no billing-gated APIs, so no consent-screen
# verification review is required even in production).
# - Create an "OAuth client ID" of type "Web application".
# - Add this exact Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
#   (e.g. http://localhost:3000/api/auth/callback/google in dev)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
