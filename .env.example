# ============================================================
# Contribution Tracker — Environment Variables Example
# Copy this file to .env.local and fill in your real credentials
# ============================================================

# Database Connection (Postgres / Supabase / Neon / Localhost)
DATABASE_URL=postgresql://postgres:password@localhost:5432/contribution_tracker

# NextAuth Secret (Generate via `npx auth secret` or random 32+ char string)
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App Credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
