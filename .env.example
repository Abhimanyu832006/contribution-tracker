# ============================================================
# Contribution Tracker — Environment Variables Example
# Copy this file to .env.local and fill in your real credentials
# ============================================================

# Database Connection (Postgres / Supabase / Neon / Localhost)
# On Supabase specifically: use the "Transaction" pooler connection string
# (port 6543, with ?pgbouncer=true), NOT the "Session" pooler (port 5432).
# Session mode caps out at a small number of concurrent clients and gets
# exhausted almost immediately by Vercel's serverless functions, each
# spinning up its own connection pool — surfacing as
# "(EMAXCONNSESSION) max clients reached in session mode".
DATABASE_URL=postgresql://postgres:password@localhost:5432/contribution_tracker

# NextAuth Secret (Generate via `npx auth secret` or random 32+ char string)
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App Credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth Client Credentials (from https://console.cloud.google.com/apis/credentials)
# This one client serves two separate flows:
#   1. Faculty sign-in via NextAuth (openid email profile only).
#   2. The Google Docs/Drive sync integration (Settings -> "Connect
#      Google Account"), a separate manual OAuth grant requesting
#      drive.readonly — this is a "sensitive" scope, so publishing the
#      app to Production without full Google verification will show
#      users an "unverified app" warning, and while the consent screen
#      is in "Testing" mode only whitelisted test users can connect at all.
# - Create an "OAuth client ID" of type "Web application".
# - Add BOTH of these exact Authorized redirect URIs:
#     {NEXTAUTH_URL}/api/auth/callback/google   (faculty sign-in)
#     {NEXTAUTH_URL}/api/auth/google/callback   (Drive sync)
#   e.g. locally: http://localhost:3000/api/auth/callback/google
#                 http://localhost:3000/api/auth/google/callback
# - Enable the "Google Drive API" for the project in the Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Vercel Blob — where uploaded supporting documents (Log Contribution's
# attachments) are stored. Required: serverless functions have a
# read-only filesystem (aside from /tmp, which doesn't persist across
# invocations), so writing to local disk fails on Vercel.
# Get this by adding a Blob store to your Vercel project: Storage tab ->
# Create Database -> Blob. Vercel injects this automatically for
# deployments; for local dev, copy it from Project Settings ->
# Environment Variables.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here
